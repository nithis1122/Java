LEET CODE- Palindrome 125
class Solution {
    public boolean isPalindrome(String s) {
        s=s.toLowerCase();
        s=s.replaceAll("[^a-z0-9]","");
        String r="";
    for (int  i = (s.length() - 1); i >=0; --i) {
    r = r + s.charAt(i);
   }
   if (s.equals(r))
   {
return true;
}
else {
return false;
}
}
}
