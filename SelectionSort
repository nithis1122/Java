import java.util.*;

public class Main
{
	public static void main(String[] args) {
		int[]arr={23,10,1,3,5,4};
		int n=arr.length;
		for(int i=0;i<n-1;i++)
		{
		    
		    int m=i;
		    for(int j=i+1;j<n;j++)
		    {
		        if (arr[j] < arr[m]) {
                    m = j;
                }
            }
            int temp = arr[m];
            arr[m] = arr[i];
            arr[i] = temp;
		    }
		    
        System.out.println("Sorted: " +Arrays.toString(arr));
		}
	}
