class Solution {
    public int sumOfUnique(int[] nums) {
        int[]c=new int[105];
        int sum=0;
        for(int num:nums)
        {
            c[num]++;
        }
        for(int i=0;i<=nums.length;i++)
        {
            if(c[i]==1)
            {
                sum+=i;
            }
        }
        return sum;
    }
}
