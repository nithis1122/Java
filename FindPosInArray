import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int[][]arr=new int[3][3];
		int n=1;
	    for(int i=0;i<3;i++)
	    {for(int j=0;j<3;j++){
	        arr[i][j]=n;
	        n++;
	    }}
	    int target=sc.nextInt();
	    for(int i=0;i<3;i++)
	    {
	        for(int j=0;j<3;j++)
	    if(arr[i][j]==target)
	    {
	        System.out.println(i+" "+j);
	    }
	        
	    }
	}
}
