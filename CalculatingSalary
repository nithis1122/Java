import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int total=0;
		for(int i=1;i<=7;i++)
		{
		    int hours=sc.nextInt();
		    int ds=0;
		    if(hours<=8)
		    {
		        ds=hours*100;
		    }
		    else
		    {
		        ds=(8*100)+(hours-8)*115;
		    }
		    if(i==1)
		    {
		        ds=ds*50/100;
		    }
		    if(i==7)
		    {
		        ds=ds*25/100;
		    }
		    total+=ds;
		}
		System.out.println(total);
	    
	}

	}
